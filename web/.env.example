# Copy to .env (git-ignored). Vite inlines VITE_* values into the browser bundle: never put secrets here.

# Origin of the PocketChaos backend (no trailing slash). It must list this dashboard's origin
# (http://localhost:5173 in dev) in its CORS_ORIGINS. Optional for `npm run dev` (defaults to
# http://localhost:4000), required for production builds (e.g. https://pocketchaos-backend.onrender.com).
VITE_API_URL=http://localhost:4000
