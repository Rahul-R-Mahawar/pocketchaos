# Optional. Copy to .env (git-ignored). EXPO_PUBLIC_* values are compiled into the app bundle that ships to
# devices: never put secrets here. The app works without both (URL presets + manual entry on the Pair tab).

# Deployed backend shown as the "Cloud" preset (and the default server on a fresh install when set), e.g. https://pocketchaos-api.onrender.com
# The live deployment is https://pocketchaos-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# Port used by the LAN / Android emulator / localhost presets. Must match the backend's PORT (default 4000).
EXPO_PUBLIC_API_PORT=4000
