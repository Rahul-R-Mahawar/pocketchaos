# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local MongoDB or an Atlas mongodb+srv:// URI.
MONGODB_URI=mongodb://127.0.0.1:27017/pocketchaos

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API (the web dashboard).
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (rate limiting). 0 for local dev, 1 behind Render/Railway/Nginx.
TRUST_PROXY=0
